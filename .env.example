# Copy to .env and fill in. The .env file is never committed.

# Database
DB_HOST=db
DB_PORT=5432
DB_NAME=ponthe
DB_USER=ponthe
DB_PASSWORD=change-me

# Redis (Celery broker and cache)
REDIS_HOST=redis
REDIS_PASSWORD=change-me

# Django
# DEBUG=True for development; in production it must be False.
DEBUG=True
# Production only. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
DOMAIN_NAME=localhost
TRUSTED_ORIGIN=http://localhost:8000
SECURE_SSL_REDIRECT=False
GUNICORN_NB_WORKERS=4

# Port published on the host
BACK_PORT=8000

# School SSO. Defaults to https://idp.enpc.fr/cas/ when unset.
# CAS_SERVER_URL=https://idp.enpc.fr/cas/
